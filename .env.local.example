# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only, never expose to the client — used in API routes / server actions
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Real-time collaboration (pick ONE provider) ----------------------------
# Option A: Liveblocks (managed, recommended for production)
LIVEBLOCKS_SECRET_KEY=sk_prod_xxx
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_prod_xxx

# Option B: self-hosted y-webrtc signaling server (if not using Liveblocks)
NEXT_PUBLIC_YWEBRTC_SIGNALING_URL=wss://your-signaling-server.example.com

# --- OAuth (configured in Supabase Dashboard > Authentication > Providers) --
# Google OAuth client id/secret are entered in the Supabase dashboard directly,
# not here — Supabase handles the OAuth redirect flow.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- File storage ------------------------------------------------------------
NEXT_PUBLIC_STORAGE_BUCKET=documents
# Only needed if using AWS S3 instead of Supabase Storage:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# --- Heavy server-side conversions (optional, for DOCX<->PDF, transcription) -
# e.g. a Gotenberg/LibreOffice conversion microservice endpoint
DOCUMENT_CONVERSION_SERVICE_URL=https://your-libreoffice-service.example.com
# Speech-to-text provider key (e.g. OpenAI Whisper API, Deepgram, AssemblyAI)
TRANSCRIPTION_API_KEY=
